# URL pública do site (usada em canonical, sitemap, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# --- Shopify (Storefront API) -------------------------------------------------
# Sem estas variáveis o site roda em MODO DEMONSTRAÇÃO, com produtos de exemplo.
SHOPIFY_STORE_DOMAIN=sua-loja.myshopify.com
# Token privado do canal "Headless" (recomendado, nunca vai para o navegador)
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Alternativa: token público do mesmo canal
# SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10
SHOPIFY_COUNTRY=BR
# SHOPIFY_LANGUAGE=PT_BR

# --- Opcionais ----------------------------------------------------------------
# Página "Minha conta" dos clientes (aparece o botão "Entrar" no cabeçalho)
# NEXT_PUBLIC_ACCOUNT_URL=https://sua-loja.myshopify.com/account
# Código de verificação do Google Search Console (tag <meta>)
# GOOGLE_SITE_VERIFICATION=
# Segredo que assina os webhooks (Shopify > Configurações > Notificações > Webhooks)
SHOPIFY_WEBHOOK_SECRET=
# Token da Admin API com permissão write_customers (inscrições da newsletter)
SHOPIFY_ADMIN_ACCESS_TOKEN=
